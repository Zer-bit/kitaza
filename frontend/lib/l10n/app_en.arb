  "settingsGuide": "Learn Kitaza",
  "guideTitle": "How to use Kitaza",
  "guideIntro": "Eight short lessons. Read them in order the first time, then come back to any one of them whenever you need it.",
  "guideProgress": "{read, plural, =0{Not started} other{{read} of {total} read}}",
  "@guideProgress": {"placeholders": {"read": {"type": "int"}, "total": {"type": "int"}}},
  "guideLessonProgress": "{count, plural, other{{count} steps}}",
