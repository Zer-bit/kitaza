# Copy to .env for local development.
KITAZA_HOST=0.0.0.0
KITAZA_PORT=8080
KITAZA_ALLOWED_ORIGINS=*
KITAZA_REQUEST_TIMEOUT_SECONDS=20
# How often an open realtime socket is pinged and its device re-checked. Lower
# it if a proxy in front of the API closes idle connections sooner than this.
KITAZA_REALTIME_KEEPALIVE_SECONDS=25

DATABASE_URL=postgres://kitaza:kitaza@localhost:5432/kitaza
DATABASE_MAX_CONNECTIONS=20
DATABASE_AUTO_MIGRATE=true

REDIS_URL=redis://localhost:6379
REDIS_DASHBOARD_TTL_SECONDS=30
REDIS_LOGIN_ATTEMPT_LIMIT=10

# Must be at least 32 characters. Generate with: openssl rand -hex 32
KITAZA_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
KITAZA_ACCESS_TOKEN_MINUTES=60
# Long-lived on purpose: a device that has signed in once should not be
# asked again for half a year.
KITAZA_REFRESH_TOKEN_DAYS=180

# Sync tuning. The settle window holds back rows younger than this so a
# transaction still in flight cannot be skipped by a device's cursor.
KITAZA_SYNC_SETTLE_MS=2000
KITAZA_SYNC_PAGE_SIZE=500

KITAZA_LOG=info,kitaza_server=debug
KITAZA_LOG_FORMAT=pretty

# Billing: off (everything free), test (pretend checkout page on this
# server), or paymongo (real GCash, Maya and card payments).
KITAZA_BILLING=off
KITAZA_PUBLIC_URL=http://localhost:8080
KITAZA_TRIAL_DAYS=30
KITAZA_GRACE_DAYS=7
# Only for KITAZA_BILLING=paymongo. From the PayMongo dashboard; the webhook
# must point at <public url>/api/v1/billing/webhooks/paymongo and send
# checkout_session.payment.paid.
KITAZA_PAYMONGO_SECRET_KEY=
KITAZA_PAYMONGO_WEBHOOK_SECRET=
